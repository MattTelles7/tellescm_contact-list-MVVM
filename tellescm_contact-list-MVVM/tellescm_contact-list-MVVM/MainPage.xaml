<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:tellescm_contact_list_MVVM.ViewModels"
             x:Class="tellescm_contact_list_MVVM.MainPage"
             x:DataType="viewModels:AddContactViewModel"
             Title="Add Contact">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="14">
            <Label Text="Add a contact"
                   FontSize="28"
                   FontAttributes="Bold"
                   SemanticProperties.HeadingLevel="Level1" />
            <Label Text="Enter the information below, then save it to your contact list."
                   TextColor="{StaticResource Gray500}" />

            <Label Text="Name" FontAttributes="Bold" />
            <Entry Text="{Binding Name}" Placeholder="Full name" />

            <Label Text="Email" FontAttributes="Bold" />
            <Entry Text="{Binding Email}" Placeholder="name@example.com" Keyboard="Email" />

            <Label Text="Phone Number" FontAttributes="Bold" />
            <Entry Text="{Binding PhoneNumber}" Placeholder="(555) 123-4567" Keyboard="Telephone" />

            <Label Text="Description" FontAttributes="Bold" />
            <Editor Text="{Binding Description}"
                    Placeholder="A short note about this contact"
                    MinimumHeightRequest="110"
                    AutoSize="TextChanges" />

            <Button Text="Save Contact"
                    Command="{Binding SaveCommand}"
                    Margin="0,10,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
