<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:tellescm_contact_list_MVVM.ViewModels"
             x:Class="tellescm_contact_list_MVVM.Views.ContactDetailsPage"
             x:DataType="viewModels:ContactDetailsViewModel"
             Title="Contact Details">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="14">
            <Label Text="Contact details"
                   FontSize="28"
                   FontAttributes="Bold"
                   SemanticProperties.HeadingLevel="Level1" />
            <Label Text="Review or update this contact's information."
                   TextColor="{StaticResource Gray500}" />

            <Label Text="Name" FontAttributes="Bold" />
            <Entry Text="{Binding Name}" />

            <Label Text="Email" FontAttributes="Bold" />
            <Entry Text="{Binding Email}" Keyboard="Email" />

            <Label Text="Phone Number" FontAttributes="Bold" />
            <Entry Text="{Binding PhoneNumber}" Keyboard="Telephone" />

            <Label Text="Description" FontAttributes="Bold" />
            <Editor Text="{Binding Description}"
                    MinimumHeightRequest="110"
                    AutoSize="TextChanges" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,10,0,0">
                <Button Grid.Column="0" Text="Back" Command="{Binding BackCommand}" />
                <Button Grid.Column="1" Text="Save Changes" Command="{Binding SaveCommand}" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
